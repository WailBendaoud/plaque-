CREATE TABLE CLIENT ( 
    NUMCLI INT NOT NULL PRIMARY KEY, 
    NOMCLI VARCHAR(100), 
    VILLE VARCHAR(100), 
    CATEGORIE VARCHAR(50), 
    COMPTE VARCHAR(50) 
); 
GO 

CREATE TABLE CLIENTAdress ( 
    NUMCLI INT NOT NULL, 
    ADDRESS1 VARCHAR(100), 
    STATE VARCHAR(50), 
    CONSTRAINT pk_ClientAddr PRIMARY KEY (NUMCLI), 
    CONSTRAINT fk_ClientAddr_Client FOREIGN KEY (NUMCLI) 
REFERENCES CLIENT(NUMCLI) 
); 
GO 

CREATE TABLE COMMANDE ( 
    NUMCOM INT NOT NULL IDENTITY(1,1), 
    NUMCLI INT NOT NULL, 
    DATECOM DATE, 
    CONSTRAINT pk_commande PRIMARY KEY (NUMCOM), 
    CONSTRAINT fk_commande_client FOREIGN KEY (NUMCLI) 
REFERENCES CLIENT(NUMCLI)
); 
GO 


CREATE TABLE DETAIL_COMMANDE ( 
ID_DETAIL INT NOT NULL IDENTITY(1,1), 
ID_COMMANDE INT NOT NULL, 
ID_PRODUIT INT NOT NULL, 
QUANTITE INT CHECK (QUANTITE >= 0), 
CONSTRAINT pk_detail PRIMARY KEY (ID_DETAIL), 
CONSTRAINT fk_detail_commande FOREIGN KEY 
(ID_COMMANDE) REFERENCES COMMANDE(NUMCOM), 
CONSTRAINT fk_detail_produit FOREIGN KEY 
(ID_PRODUIT) REFERENCES PRODUITS(ID) 
); 
GO 

